{
  "name": "v-range-flyout",
  "version": "2.0.2",
  "description": "A Vue 3 component that wraps an input[type=number] with a customizable range slider flyout.",
  "author": "Ron Gilchrist (thewebkid)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/v-range-flyout.umd.cjs",
  "module": "./dist/v-range-flyout.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/v-range-flyout.js",
      "require": "./dist/v-range-flyout.umd.cjs"
    },
    "./style.css": "./dist/v-range-flyout.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/*",
    "src/index.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "javascript",
    "number-slider",
    "range-slider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thewebkid/v-range-flyout.git"
  },
  "homepage": "https://thewebkid.com/modules/v-range-flyout",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "lit-movable": "^1.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "sass": "^1.83.0",
    "vite": "^6.0.0",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=18"
  }
}
